# PostgreSQL 連線字串 — 對應 docker-compose.yml 裡的 db 服務。
# 直接用 Docker Compose 啟動時這個值已由 compose 檔覆蓋，
# 只有在本機直接執行 next dev（不透過 Docker）時才需要手動修改。
DATABASE_URL="postgresql://locker:locker@localhost:5432/locker"

# 本系統（Next.js）用來簽署登入 session 的密鑰。
# 與智能柜 Cookie 無關。請改成至少 32 個字元的隨機字串，
# 例如：openssl rand -base64 32
# 不可留空、不可使用預設值。
SESSION_SECRET="replace-with-at-least-32-character-secret"

# 伺服器時區。Docker Compose 已預設設為 Asia/Hong_Kong，一般不需修改。
TZ="Asia/Hong_Kong"

# ── 智能柜 OpenLog Cookie（半自動；等同 Coolify Secret）────────────────
# 只放 Cookie，永遠不要把 ITCode／密碼寫進這裡或 Git。
# Cookie 名稱預設為 .AspNetCore.Face.CookieWithJwtAuth（不是 Identity.Application）。
# 可填完整 Cookie 標頭字串（name=value），或只填 token 值（系統會自動加上名稱）。
# 有設定時優先於 Settings 頁貼上的 session_payload；Settings 仍可作後備。
# LOCKER_AUTH_COOKIE=""
# LOCKER_AUTH_COOKIE_NAME=".AspNetCore.Face.CookieWithJwtAuth"

# 可選。有設定時，Excel 下載會優先用此內聯網網址，而非 Settings 的 intranetBaseUrl。
# LOCKER_INTRANET_BASE_URL="http://10.127.7.200:17789"
